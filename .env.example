# Optional. docker-compose runs without this file; copy it to .env to override a default.

# --- AI ----------------------------------------------------------------------
# With no key, the API uses its deterministic mock model, so every demo scenario still works.
ANTHROPIC_API_KEY=
# Any current Claude model id. Replies and extraction run at low effort to keep chat latency down.
ANTHROPIC_MODEL=claude-opus-5-5
# Force the mock model even when a key is set (true | false).
MOCK_LLM=false

# --- Auth --------------------------------------------------------------------
# Signs session cookies. The compose default is for local use only; set a long random value anywhere else.
JWT_SECRET=
# Password for the support dashboard at /admin.
ADMIN_PASSWORD=
# Kill switch for automatic refunds (true | false); false sends every would-be approval to a person.
AUTO_REFUNDS_ENABLED=true
# Reviewer tools: the demo reset (and test orders). Turn off for anything real.
DEMO_MODE=true

# --- Ports on your machine ---------------------------------------------------
WEB_PORT=3000
API_PORT=4000
DB_PORT=5433
