# Only needed to run the API outside Docker (npm run start:dev). Copy to apps/api/.env.
# Start just the database with: docker compose up db
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://refunds:refunds@localhost:5433/refunds
# Migrations use DIRECT_URL; behind a pooler (Supabase) it is the direct connection string.
DIRECT_URL=postgresql://refunds:refunds@localhost:5433/refunds
# Comma-separated origins allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Optional: lock /docs behind basic auth on a public deploy.
DOCS_USERNAME=
DOCS_PASSWORD=
# Signs session cookies (24+ characters). Required: the API refuses to boot without it.
JWT_SECRET=local-only-secret-change-me-before-any-deploy
# Password for the support dashboard (8+ characters).
ADMIN_PASSWORD=refund-desk-admin
# Optional. With no key the deterministic mock model runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
MOCK_LLM=false
# Kill switch for automatic refunds; false sends every would-be approval to a person.
AUTO_REFUNDS_ENABLED=true
# Reviewer tools: the demo reset (and test orders). Off unless set.
DEMO_MODE=true
